# Copy to .env (`make env`) and fill in. .env is gitignored; never commit keys.

# Free key: sign in at https://aisstream.io and create an API key
AISSTREAM_API_KEY=
# Free key: request one at https://docs.airnowapi.org/account/request/
AIRNOW_API_KEY=

# Kafka as seen from your laptop (the containers use kafka:9092)
KAFKA_BOOTSTRAP=localhost:9094
KAFKA_HOST_PORT=9094
CONSOLE_PORT=8085

# Spark needs Java 17 on your laptop (the containers bring their own)
SPARK_DRIVER_MEMORY=6g
JAVA_HOME=/opt/homebrew/opt/openjdk@17
